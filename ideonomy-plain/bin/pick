#!/usr/bin/env bash
# pick — randomly select a method tuple from the ideonomy catalog
#
# Usage:
#   bin/pick                    # default: 2 operators, 1 organon, 3 dim-prompts
#   bin/pick --more             # bigger tuple: 3 operators, 2 organons, 5 dim-prompts
#   bin/pick --less             # smaller: 1 operator, 1 organon, 2 dim-prompts
#   bin/pick --print            # only print the picks; don't cat the bodies
#   bin/pick --seed N           # replay on the same Bash/awk and catalog
#   bin/pick --cooldown-dir DIR # opt-in usage history, outside the skill
#
# Default runs are read-only and offline. Draws may repeat. Cooldown adds a
# recency penalty with a one-hour half-life; it does not measure idea quality.
# Seeded runs ignore cooldown and do not write history.

set -euo pipefail
export LC_ALL=C

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
METHODS="$ROOT/methods"
HALF_LIFE=3600   # 1 hour, in seconds

OPS_N=2
ORG_N=1
DIM_N=3
PRINT_ONLY=0
SEED=""
COOLDOWN_DIR=""

fail() { echo "error: $*" >&2; exit 2; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --print)       PRINT_ONLY=1; shift ;;
    --seed)
      [[ $# -ge 2 && "$2" =~ ^[0-9]{1,5}$ ]] || fail "--seed requires an integer from 0 to 32767"
      SEED=$((10#$2))
      (( SEED <= 32767 )) || fail "--seed requires an integer from 0 to 32767"
      shift 2 ;;
    --cooldown-dir)
      [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || fail "--cooldown-dir requires a directory"
      COOLDOWN_DIR="$2"; shift 2 ;;
    --more)        OPS_N=3; ORG_N=2; DIM_N=5; shift ;;
    --less)        OPS_N=1; ORG_N=1; DIM_N=2; shift ;;
    -h|--help)
      sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "Unknown arg: $1" >&2
      exit 2
      ;;
  esac
done

# Seed the bash RNG.
if [[ -n "$SEED" ]]; then
  RANDOM=$SEED
else
  RANDOM=$(( $(date +%s) ^ $$ ))
fi

# Detect stat flavor (BSD/macOS vs GNU/Linux).
if stat -f %m / >/dev/null 2>&1; then
  STAT_MTIME=( -f %m )
else
  STAT_MTIME=( -c %Y )
fi
NOW=$(date +%s)

# pick_n DIR N SEED — echo N files (one per line), weighted against recency.
# Searches recursively under DIR. Skips README.md and files starting "_".
# Under --seed, weighting is disabled so picks stay reproducible.
pick_n() {
  local dir="$1" n="$2" seed="$3"
  [[ -d "$dir" ]] || fail "missing method directory: $dir"
  local weight_enabled=0
  [[ -n "$COOLDOWN_DIR" && -z "$SEED" ]] && weight_enabled=1
  find "$dir" -type f -name '*.md' ! -name 'README.md' ! -name '_*' 2>/dev/null \
    | sort \
    | while IFS= read -r f; do
        m=0
        if (( weight_enabled )); then
          state="$COOLDOWN_DIR/${f#"$METHODS/"}"
          m=$(stat "${STAT_MTIME[@]}" "$state" 2>/dev/null || echo 0)
        fi
        printf '%s\t%s\n' "$m" "$f"
      done \
    | awk -F'\t' -v seed="$seed" -v now="$NOW" -v half="$HALF_LIFE" -v weighted="$weight_enabled" '
        BEGIN { srand(seed) }
        {
          mtime = $1
          file  = $2
          if (weighted) {
            age   = now - mtime
            if (age < 0) age = 0
            penalty = exp(-log(2) * age / half)   # ~1 just-touched, ~0 long-cold
            score   = rand() + penalty   # bigger = less likely to be picked
          } else {
            score = rand()               # pure rand under --seed
          }
          printf "%.17g\t%s\n", score, file
        }
      ' \
    | sort -k1,1n \
    | awk -v n="$n" 'NR <= n { print } END { if (NR < n) { print "error: insufficient methods in category" > "/dev/stderr"; exit 2 } }' \
    | cut -f2-
}

# Pre-evaluate $RANDOM in the parent shell. In bash 3.2, $RANDOM inside a
# command substitution's args is evaluated in the *subshell's* RNG, which has
# its own (non-deterministic) seed — so reproducibility under --seed only
# works if we capture the seeds here first.
SEED_OPS=$RANDOM
SEED_ORGS=$RANDOM
SEED_DIMS=$RANDOM

OPS=$(pick_n  "$METHODS/operators"          "$OPS_N" "$SEED_OPS")
ORGS=$(pick_n "$METHODS/organons"           "$ORG_N" "$SEED_ORGS")
DIMS=$(pick_n "$METHODS/dimension-prompts"  "$DIM_N" "$SEED_DIMS")

# --- Header ---
printf '=== IDEONOMY METHOD TUPLE (this invocation) ===\n\n'

print_block() {
  local label="$1" files="$2"
  [[ -z "$files" ]] && return
  printf '%s:\n' "$label"
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    name=$(basename "$f" .md)
    printf '  - %s\n' "$name"
  done <<< "$files"
  printf '\n'
}

print_block "OPERATORS"         "$OPS"
print_block "ORGANONS"          "$ORGS"
print_block "DIMENSION-PROMPTS" "$DIMS"

printf '==============================================\n'

# --- Bodies ---
if (( ! PRINT_ONLY )); then
  cat_files() {
    local files="$1"
    [[ -z "$files" ]] && return
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      printf '\n----- %s -----\n' "$f"
      cat "$f"
    done <<< "$files"
  }

  cat_files "$OPS"
  cat_files "$ORGS"
  cat_files "$DIMS"
fi

# Store usage separately; never touch installed method files.
if [[ -n "$COOLDOWN_DIR" && -z "$SEED" ]]; then
  printf '%s\n%s\n%s\n' "$OPS" "$ORGS" "$DIMS" | while IFS= read -r f; do
    state="$COOLDOWN_DIR/${f#"$METHODS/"}"
    mkdir -p "$(dirname "$state")"
    touch "$state"
  done
fi
